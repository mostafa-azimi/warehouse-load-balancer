# Preferred read-only analysis source: ShipHero/ShipBots SQL data export.
SHIPBOTS_SQL_SERVER=
SHIPBOTS_SQL_PORT=5500
SHIPBOTS_SQL_DATABASE=sbsql
SHIPBOTS_SQL_USER=
SHIPBOTS_SQL_PASSWORD=
SHIPBOTS_SQL_ENCRYPT=false

# Used for OAuth refresh, future approved writes, and as an analysis fallback
# when the SQL export is not configured. Leave both data sources empty for demo mode.
SHIPHERO_ACCESS_TOKEN=
SHIPHERO_REFRESH_TOKEN=
SHIPHERO_CLIENT_ID=

# Comma-separated public API IDs or numeric account numbers. Add =Name to override the display name.
ALLOWED_CUSTOMER_ACCOUNT_IDS=10001=Example Client,10002=Another Client

# Live writes intentionally remain disabled in this MVP.
SHIPHERO_WRITE_MODE=preview

# Vercel supplies CRON_SECRET to authenticated cron requests.
CRON_SECRET=

# Injected automatically when the Upstash Redis integration is connected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
